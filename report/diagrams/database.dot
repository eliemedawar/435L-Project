digraph Database {
graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=1.0, label="Database design — Marc Bteich", labelloc=t, fontname="Arial"];
node [shape=plain,fontname="Arial"]; edge [fontname="Arial",fontsize=9,color="#64748b",arrowsize=0.65];
assets [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>assets</B></TD></TR><TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">asset_name </TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">asset_type </TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">ip_address </TD><TD ALIGN="LEFT">VARCHAR(45)</TD></TR><TR><TD ALIGN="LEFT">operating_system </TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">owner_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">department </TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">location </TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">criticality </TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">status </TD><TD ALIGN="LEFT">VARCHAR(25)</TD></TR></TABLE>>];
users -> assets [label="owner_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
incidents [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>incidents</B></TD></TR><TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">title </TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">description </TD><TD ALIGN="LEFT">VARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">category </TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">severity </TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">reporter_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">asset_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">assigned_analyst_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">status </TD><TD ALIGN="LEFT">VARCHAR(25)</TD></TR><TR><TD ALIGN="LEFT">created_at </TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">resolved_at </TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
users -> incidents [label="assigned_analyst_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
assets -> incidents [label="asset_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
users -> incidents [label="reporter_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
investigation_notes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>investigation_notes</B></TD></TR><TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">incident_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">analyst_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">content </TD><TD ALIGN="LEFT">VARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">created_at </TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
users -> investigation_notes [label="analyst_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
incidents -> investigation_notes [label="incident_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
logs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>logs</B></TD></TR><TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">user_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">username </TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">action </TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">description </TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT">severity </TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">related_service </TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">timestamp </TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
users -> logs [label="user_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
notifications [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>notifications</B></TD></TR><TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">user_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">title </TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">message </TD><TD ALIGN="LEFT">VARCHAR(1000)</TD></TR><TR><TD ALIGN="LEFT">notification_type </TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">severity </TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">status </TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">created_at </TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">read_at </TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
users -> notifications [label="user_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
playbooks [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>playbooks</B></TD></TR><TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">name </TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">description </TD><TD ALIGN="LEFT">VARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">incident_category </TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">severity </TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">created_by FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">created_at </TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
users -> playbooks [label="created_by: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
response_actions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>response_actions</B></TD></TR><TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">playbook_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">description </TD><TD ALIGN="LEFT">VARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">step_number </TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">status </TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">assigned_user_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">completion_date </TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">execution_history </TD><TD ALIGN="LEFT">JSON</TD></TR></TABLE>>];
users -> response_actions [label="assigned_user_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
playbooks -> response_actions [label="playbook_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
threats [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>threats</B></TD></TR><TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">threat_type </TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">threat_value </TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">description </TD><TD ALIGN="LEFT">VARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">severity </TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">source </TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">date_added </TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">full_name </TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">username </TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">email </TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">password_hash </TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">department </TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">role </TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">account_status </TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">created_at </TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">last_login </TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
vulnerabilities [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>vulnerabilities</B></TD></TR><TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">title </TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">description </TD><TD ALIGN="LEFT">VARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">cve_id </TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT">cvss_score </TD><TD ALIGN="LEFT">NUMERIC(3,1)</TD></TR><TR><TD ALIGN="LEFT">severity </TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">asset_id FK</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">discovery_source </TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">status </TD><TD ALIGN="LEFT">VARCHAR(25)</TD></TR><TR><TD ALIGN="LEFT">created_at </TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT">resolution_date </TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
assets -> vulnerabilities [label="asset_id: 1 to many",dir=both,arrowtail=tee,arrowhead=crow];
}
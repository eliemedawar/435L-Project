  "item": [
    {
      "name": "0. Setup - log in",
      "item": [
        {
          "name": "Login - admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Uses the standard response format\", () => pm.expect(pm.response.json()).to.have.property(\"status\"));",
                  "const json = pm.response.json();",
                  "if (json.data) pm.collectionVariables.set(\"token_admin\", json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_users}}/users/login",
              "host": [
                "{{base_users}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "description": "**Developed by: Elie Medawar**\n\nSetup: log in and store the token.\n\nExpected: HTTP 200",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }

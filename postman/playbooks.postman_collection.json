      "name": "0. Login existing accounts",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_users}}/users/login",
            "description": "Developed by: Marc Bteich. Login admin. Expected HTTP 200. Input/body and authentication are defined in this request; successful responses use status/message/data and errors use status/message.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body=pm.response.json();",
                  "pm.test(\"Response envelope\", () => {pm.expect(body.status).to.eql(\"success\");pm.expect(body.message).to.be.a(\"string\");});",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"token_admin\",body.data.token);",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"owner_id\",body.data.user.id);"
                ]
              }
            }

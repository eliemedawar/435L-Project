# Copy this file to .env and replace the values. Never commit .env.
# Generate random values with:  python -c "import secrets; print(secrets.token_hex(32))"
# Both teammates' .env files MUST use the same SERVICE_KEY and JWT_SECRET when running together.

JWT_SECRET=change-me
SERVICE_KEY=change-me
JWT_EXPIRES_MIN=60

# Leave empty to use SQLite at database/sidrms.db
DATABASE_URL=

# 1 = Flask debug mode with auto-reload
FLASK_DEBUG=0
